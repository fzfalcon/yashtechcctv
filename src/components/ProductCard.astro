---
import { BASE, asset, waLink } from '../lib';
const { product } = Astro.props;
---
<article class="surface-card product-card reveal" data-product data-category={product.category} data-title={product.title.toLowerCase()}>
  <a href={`${BASE}products/${product.slug}/`} aria-label={`View ${product.title} details`}>
    <div class="product-image"><img src={asset(product.image)} alt={product.alt || product.title} loading="lazy" width="520" height="420" /></div>
  </a>
  <div class="product-info">
    <span class="category-tag">{product.category}</span>
    <h3><a href={`${BASE}products/${product.slug}/`}>{product.title}</a></h3>
    <p>{product.description.length > 125 ? `${product.description.slice(0,122)}…` : product.description}</p>
    <div class="product-meta"><a class="text-link" href={`${BASE}products/${product.slug}/`}>Specifications ↗</a><a class="text-link" href={waLink(`Hello YASH TECH, I am interested in ${product.title}. Please share current availability and price.`)} target="_blank" rel="noopener noreferrer">Ask price ↗</a></div>
  </div>
</article>
