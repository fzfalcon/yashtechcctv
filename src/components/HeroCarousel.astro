---
import slides from '../data/slides.json';
import { asset, BASE, waLink } from '../lib';
const heroSlides = slides.map((slide, index) => ({ ...slide, number: String(index + 1).padStart(2, '0') }));
---
<section class="v30-home-hero" data-carousel aria-label="YASH TECH featured security campaigns">
  <div class="v30-carousel-stage">
    {heroSlides.map((slide, index) => (
      <figure class:list={['v30-carousel-slide', index === 0 && 'is-active']} data-slide data-title={slide.title} data-description={slide.description} aria-hidden={index !== 0}>
        <a href={`${BASE}products/`} tabindex={index === 0 ? 0 : -1} aria-label={`Explore products featured in ${slide.title}`} data-slide-link>
          <img src={asset(slide.image)} alt={slide.alt} width="1672" height="941" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : undefined} />
        </a>
      </figure>
    ))}
    <div class="v30-carousel-shade" aria-hidden="true"></div>
    <div class="v30-carousel-corner v30-carousel-corner-left"><span class="status-pip"></span> YASH TECH / SECURITY SYSTEMS</div>
    <div class="v30-carousel-corner v30-carousel-corner-right"><span data-current>01</span><i></i><span>07</span></div>
    <button class="v30-carousel-arrow v30-carousel-prev" type="button" data-prev aria-label="Previous campaign">‹</button>
    <button class="v30-carousel-arrow v30-carousel-next" type="button" data-next aria-label="Next campaign">›</button>
  </div>
  <div class="v30-carousel-rail">
    <div class="container v30-carousel-rail-inner">
      <div class="v30-carousel-pagination">
        <div class="v30-carousel-dots" aria-label="Choose a campaign">
          {heroSlides.map((slide, index) => <button type="button" data-dot={index} aria-label={`Show campaign ${index + 1}: ${slide.title}`} aria-pressed={index === 0 ? 'true' : 'false'} class:list={{ 'is-active': index === 0 }}></button>)}
        </div>
        <div class="v30-carousel-progress" aria-hidden="true"><span data-progress></span></div>
      </div>
      <div class="v30-carousel-controls">
        <button type="button" data-pause aria-label="Pause automatic campaign slider">Ⅱ <span>Pause</span></button>
        <a href={`${BASE}products/`} class="v30-carousel-link">Explore products <span aria-hidden="true">↗</span></a>
        <a href={waLink('Hello YASH TECH, I would like to enquire about CCTV and security products.')} target="_blank" rel="noopener noreferrer" class="v30-carousel-quote">Get a quote <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
  <div class="v30-quick-access">
    <div class="container v30-quick-access-inner">
      <span class="v30-quick-label">QUICK ACCESS</span>
      <a href={`${BASE}products/`}>CCTV cameras <b aria-hidden="true">↗</b></a>
      <a href={`${BASE}products/?category=4G%20%2F%20Solar`}>4G & solar <b aria-hidden="true">↗</b></a>
      <a href={`${BASE}products/?category=Wi-Fi%20Cameras`}>Wi-Fi cameras <b aria-hidden="true">↗</b></a>
      <a href={`${BASE}products/?category=DVR%20%2F%20NVR`}>DVR / NVR systems <b aria-hidden="true">↗</b></a>
      <a href={`${BASE}services/`}>Installation & support <b aria-hidden="true">↗</b></a>
    </div>
  </div>
</section>
<script>
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const items = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
    const current = carousel.querySelector<HTMLElement>('[data-current]');
    const progress = carousel.querySelector<HTMLElement>('[data-progress]');
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const pauseButton = carousel.querySelector<HTMLButtonElement>('[data-pause]');
    let index = 0;
    let paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let hoverPaused = false;
    let timer = 0;
    const render = (next: number) => {
      index = (next + items.length) % items.length;
      items.forEach((item, i) => {
        item.classList.toggle('is-active', i === index);
        item.setAttribute('aria-hidden', String(i !== index));
        const link = item.querySelector<HTMLAnchorElement>('[data-slide-link]');
        if (link) link.tabIndex = i === index ? 0 : -1;
      });
      if (current) current.textContent = String(index + 1).padStart(2, '0');
      if (progress) progress.style.width = `${((index + 1) / items.length) * 100}%`;
      dots.forEach((dot, i) => {
        dot.classList.toggle('is-active', i === index);
        dot.setAttribute('aria-pressed', String(i === index));
      });
    };
    const restart = () => {
      window.clearInterval(timer);
      if (!paused && !hoverPaused && !document.hidden) timer = window.setInterval(() => render(index + 1), 6500);
    };
    carousel.querySelector('[data-prev]')?.addEventListener('click', () => { render(index - 1); restart(); });
    carousel.querySelector('[data-next]')?.addEventListener('click', () => { render(index + 1); restart(); });
    dots.forEach(dot => dot.addEventListener('click', () => { render(Number(dot.dataset.dot)); restart(); }));
    pauseButton?.addEventListener('click', () => {
      paused = !paused;
      pauseButton.innerHTML = paused ? '▶ <span>Play</span>' : 'Ⅱ <span>Pause</span>';
      pauseButton.setAttribute('aria-label', paused ? 'Play automatic campaign slider' : 'Pause automatic campaign slider');
      restart();
    });
    carousel.addEventListener('mouseenter', () => { hoverPaused = true; window.clearInterval(timer); });
    carousel.addEventListener('mouseleave', () => { hoverPaused = false; restart(); });
    document.addEventListener('visibilitychange', restart);
    render(0);
    restart();
  }
</script>
