interface Reel {
  id: string;
  number: string;
}
interface Props { reels: Reel[]; compact?: boolean; }
const { reels, compact = false }: Props = Astro.props;
---
<div class:list={['instagram-reel-grid', compact && 'instagram-reel-grid--compact']}>
  {reels.map((reel) => (
    <article class="reel-tile reveal" data-reel-tile data-reel-id={reel.id} data-reel-number={reel.number}>
      <div class="reel-player reel-lazy-player">
        <div class="reel-fallback">
          <span class="reel-instagram-mark" aria-hidden="true">◎</span>
          <span class="reel-fallback-kicker">YASH TECH / INSTAGRAM</span>
          <strong>Reel {reel.number}</strong>
          <p>Product videos, security solutions and updates from YASH TECH.</p>
          <button type="button" class="reel-load-button" data-load-reel>Load Reel here <span aria-hidden="true">▶</span></button>
          <a class="reel-direct-link" href={`https://www.instagram.com/reel/${reel.id}/`} target="_blank" rel="noopener noreferrer">Open original on Instagram ↗</a>
        </div>
      </div>
      <div class="reel-tile-footer"><a class="text-link" href={`https://www.instagram.com/reel/${reel.id}/`} target="_blank" rel="noopener noreferrer">Open Reel on Instagram ↗</a></div>
    </article>
  ))}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-reel-tile]').forEach((tile) => {
    const button = tile.querySelector<HTMLButtonElement>('[data-load-reel]');
    button?.addEventListener('click', () => {
      if (tile.querySelector('iframe')) return;
      const id = tile.dataset.reelId;
      const number = tile.dataset.reelNumber || '';
      if (!id) return;
      const frame = document.createElement('iframe');
      frame.className = 'instagram-embed-frame';
      frame.src = `https://www.instagram.com/reel/${encodeURIComponent(id)}/embed/`;
      frame.title = `YASH TECH Instagram Reel ${number}`;
      frame.loading = 'lazy';
      frame.allow = 'autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share';
      frame.referrerPolicy = 'strict-origin-when-cross-origin';
      frame.allowFullscreen = true;
      frame.width = '400'; frame.height = '600';
      const player = tile.querySelector<HTMLElement>('.reel-player');
      if (player) { player.classList.add('is-embedded'); player.replaceChildren(frame); }
    });
  });
</script>
