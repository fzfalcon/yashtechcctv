---
interface Reel {
  id: string;
  number: string;
  image?: string;
}

interface Props {
  reels: Reel[];
  compact?: boolean;
}

const { reels, compact = false }: Props = Astro.props;
---
<div class:list={['instagram-reel-grid', compact && 'instagram-reel-grid--compact']}>
  {reels.map((reel) => (
    <article class="reel-tile reveal">
      <div class="reel-player is-embedded">
        <iframe
          class="instagram-embed-frame"
          src={`https://www.instagram.com/reel/${encodeURIComponent(reel.id)}/embed/`}
          title={`YASH TECH Instagram Reel ${reel.number}`}
          loading="lazy"
          allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
          width="400"
          height="600"
        ></iframe>
      </div>
      <div class="reel-tile-footer">
        <a
          class="text-link"
          href={`https://www.instagram.com/reel/${reel.id}/`}
          target="_blank"
          rel="noopener noreferrer"
        >Open Reel on Instagram ↗</a>
      </div>
    </article>
  ))}
</div>
