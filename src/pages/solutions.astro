---
import Layout from '../components/Layout.astro';
import { BASE, waLink } from '../lib';
---
<Layout title="Security Solutions | YASH TECH" description="Start with the property, coverage requirements and connectivity available. YASH TECH can help you discuss suitable product options.">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={BASE}>Home</a> / Solutions</div><div class="eyebrow">Solutions</div><h1>A security setup shaped around your site.</h1><p>Start with the property, coverage requirements and connectivity available. YASH TECH can help you discuss suitable product options.</p></div></section>
  <section class="section"><div class="container"><div class="grid-3"><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Home security</h3><p>Explore indoor and outdoor camera options for entrances, living areas and other key spaces.</p><a class="text-link" href="#" data-enquiry>Discuss home security ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Shop &amp; retail</h3><p>Discuss camera placement, recording and remote viewing for a shop or retail environment.</p><a class="text-link" href="#" data-enquiry>Plan shop security ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Office &amp; workplace</h3><p>Explore recording, network and access-control needs for a workplace.</p><a class="text-link" href="#" data-enquiry>Plan office security ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Outdoor &amp; remote sites</h3><p>Ask about 4G or solar-powered camera options where wired internet or power may be limited.</p><a class="text-link" href="#" data-enquiry>Explore 4G and solar ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Multi-camera systems</h3><p>Discuss recorder channel counts, camera compatibility and storage requirements.</p><a class="text-link" href="#" data-enquiry>Plan a multi-camera setup ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Connectivity &amp; access</h3><p>Talk through remote viewing, Wi-Fi, Ethernet and network requirements.</p><a class="text-link" href="#" data-enquiry>Discuss connectivity ↗</a></article></div></div></section>
  <script>
    document.querySelectorAll<HTMLAnchorElement>('[data-enquiry]').forEach(link => {
      link.href = `https://wa.me/918667015532?text=${encodeURIComponent('Hello YASH TECH, I would like to enquire about ' + link.closest('article')?.querySelector('h3')?.textContent + '.') }`;
      link.target = '_blank'; link.rel = 'noopener noreferrer';
    });
    const form = document.querySelector<HTMLFormElement>('#enquiry-form');
    form?.addEventListener('submit', event => {
      event.preventDefault();
      const data = new FormData(form);
      const message = [
        'Hello YASH TECH, I would like to make an enquiry.',
        `Name: ${data.get('name') || 'Not provided'}`,
        `Phone: ${data.get('phone') || 'Not provided'}`,
        `Requirement: ${data.get('need') || 'Not specified'}`,
        `Details: ${data.get('details') || 'Not provided'}`
      ].join('\\n');
      window.open(`https://wa.me/918667015532?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });
  </script>
</Layout>
