---
import Layout from '../components/Layout.astro';
import { BASE } from '../lib';
---
<Layout title="Contact YASH TECH | CCTV Ramanathapuram" description="Share a few details about your property and requirements. The enquiry form prepares a WhatsApp message for you to review and send.">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={BASE}>Home</a> / Contact</div><div class="eyebrow">Contact</div><h1>Let's talk about your security needs.</h1><p>Share a few details about your property and requirements. The enquiry form prepares a WhatsApp message for you to review and send.</p></div></section>
  <section class="section"><div class="container"><div class="contact-layout">
          <section class="surface-card contact-panel"><div class="eyebrow">Visit the shop</div><h2>YASH TECH</h2>
          <div class="contact-line"><small>Address</small>152/1 Railway Station Road, opposite Kalyan Jewellerys, Ramanathapuram – 623504</div>
          <div class="contact-line"><small>Phone</small><a href="tel:+919385898667">+91 93858 98667</a></div>
          <div class="contact-line"><small>WhatsApp enquiries</small><a href="https://wa.me/918667015532">+91 86670 15532 ↗</a></div>
          <div class="contact-line"><small>Instagram</small><a href="https://www.instagram.com/yashtechcctv/" target="_blank" rel="noopener noreferrer">@yashtechcctv ↗</a></div>
          <a class="btn btn-secondary" style="margin-top:20px" href="https://www.google.com/maps/search/?api=1&query=152%2F1%20Railway%20Station%20Road%20Ramanathapuram%20623504" target="_blank" rel="noopener noreferrer">Open map ↗</a></section>
          <form class="surface-card contact-panel" id="enquiry-form"><h2>Send an enquiry</h2><p class="muted">Your message opens in WhatsApp so you can review it before sending.</p>
          <div class="form-grid"><label>Name<input class="field" name="name" required autocomplete="name" placeholder="Your name"></label><label>Phone<input class="field" name="phone" type="tel" autocomplete="tel" placeholder="Your phone"></label><label class="full">What do you need?<select class="field" name="need"><option>CCTV camera</option><option>Installation</option><option>DVR / NVR</option><option>Wi-Fi / 4G camera</option><option>Biometric / access control</option><option>Service and support</option><option>Other</option></select></label><label class="full">Property or requirement<textarea class="field" name="details" rows="4" placeholder="Tell us about the site and what you need"></textarea></label><div class="full"><button class="btn btn-primary" type="submit">Prepare WhatsApp enquiry ↗</button></div></div></form></div></div></section>
  <script>
    document.querySelectorAll<HTMLAnchorElement>('[data-enquiry]').forEach(link => {
      link.href = `https://wa.me/918667015532?text=${encodeURIComponent('Hello YASH TECH, I would like to enquire about ' + link.closest('article')?.querySelector('h3')?.textContent + '.') }`;
      link.target = '_blank'; link.rel = 'noopener noreferrer';
    });
    const form = document.querySelector<HTMLFormElement>('#enquiry-form');
    form?.addEventListener('submit', event => {
      event.preventDefault();
      const data = new FormData(form);
      const message = [
        'Hello YASH TECH, I would like to make an enquiry.',
        `Name: ${data.get('name') || 'Not provided'}`,
        `Phone: ${data.get('phone') || 'Not provided'}`,
        `Requirement: ${data.get('need') || 'Not specified'}`,
        `Details: ${data.get('details') || 'Not provided'}`
      ].join('\\n');
      window.open(`https://wa.me/918667015532?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });
  </script>
</Layout>
