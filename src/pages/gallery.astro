---
import Layout from '../components/Layout.astro';
import InstagramReelGrid from '../components/InstagramReelGrid.astro';
import products from '../data/products.json';
import slides from '../data/slides.json';
import { BASE, asset } from '../lib';
const reels = [
  { id: 'DecbWZYz1bk', number: '01' }, { id: 'DeCTb3UpncP', number: '02' }, { id: 'DeAPCdczwML', number: '03' },
  { id: 'DdMsfgjTcNp', number: '04' }, { id: 'Dc3qrbtJdqC', number: '05' }, { id: 'Dcq5zDDJ18u', number: '06' },
  { id: 'DcqyQ9jpLcy', number: '07' }, { id: 'DcquMAdprVQ', number: '08' }, { id: 'DcjU_3ZJqXj', number: '09' }, { id: 'DcJs70vS6Xe', number: '10' }
];
const currentProductPhotos = products.map((product, index) => ({ title: product.title, image: product.image, alt: product.alt || product.title, number: index + 1 }));
const additionalProductPhotos = ([
  ['001.jpg','Outdoor antenna camera'], ['002.jpg','Dual-antenna camera'], ['003.jpg','Pan-tilt outdoor camera'], ['004.jpg','Solar PTZ camera'], ['005.jpg','CCTV system accessory'],
  ['034.jpg','Outdoor bullet camera'], ['035.jpg','Dome security camera'], ['036.jpg','Outdoor camera'], ['037.jpg','Bullet camera'], ['038.jpg','Dome camera'],
  ['042.jpg','Ceiling dome camera'], ['044.jpg','Outdoor bullet camera'], ['045.jpg','Dome security camera'], ['049.jpg','Outdoor antenna camera'], ['050.jpg','Pan-tilt camera'],
  ['051.jpg','Dual-lens camera'], ['052.jpg','Indoor security camera'], ['053.jpg','Multi-camera system'], ['054.jpg','Outdoor camera'], ['055.jpg','Camera and viewing setup'], ['056.jpg','Bulb-style camera'],
  ['WhatsApp_Image_2022-12-10_at_10_36_27_AM.jpeg','DVR recording system'], ['WhatsApp_Image_2022-12-10_at_10_36_27_AM_(1).jpeg','NVR recording system']
] as const).map(([file, title], index) => ({ title, image: `assets/legacy-site/images/tour/${file}`, number: index + 1 }));
const galleryImages = ([
  ['NAGA-HEALTHCARE-SOLUTION.jpg','Naga Healthcare Solution'], ['PON-SUZUKI.jpg','Pon Suzuki'], ['RAMNAD-ENTERPRISES.jpeg','Ramnad Enterprises'], ['SKYTECH.jpeg','Skytech'],
  ['TMB.jpeg','TMB'], ['UBI.jpeg','Union Bank of India'], ['UTA.jpeg','UTA'], ['YAMAHA.jpeg','Yamaha']
] as const).map(([file, title], index) => ({ title, image: `assets/legacy-site/images/gallery/${file}`, number: index + 1 }));
const campaignImages = ([
  ['F786B310-62A6-47F4-B4FA-CD3AD45A1781.jpeg','CCTV security systems'],
  ['WhatsApp_Image_2022-12-03_at_07_55_24.jpeg','Security camera solutions'],
  ['WhatsApp_Image_2022-12-03_at_10_44_19_(1).jpeg','CCTV camera systems'],
  ['WhatsApp_Image_2022-12-03_at_10_44_19_(2).jpeg','Security products'],
  ['WhatsApp_Image_2022-12-03_at_10_44_19_(3).jpeg','Complete surveillance setup']
] as const).map(([file, title], index) => ({ title, image: `assets/legacy-site/images/banner/${file}`, number: index + 1 }));
const additionalMedia = ([
  ['008.jpg','Security systems'], ['016.jpg','Outdoor camera solutions'], ['017.jpg','CCTV product spotlight']
] as const).map(([file, title], index) => ({ title, image: `assets/legacy-site/images/yt/${file}`, number: index + 1 }));
---
<Layout title="YASH TECH Gallery | CCTV Products, Campaigns & Instagram Reels" description="Explore YASH TECH camera and recording-system photos, campaign visuals, gallery highlights and Instagram Reels.">
  <section class="page-hero command-page-hero"><div class="container"><div class="breadcrumbs"><a href={BASE}>Home</a> / Gallery</div><div class="eyebrow">YASH TECH / GALLERY</div><h1>Explore the visuals.</h1><p>Browse camera products, recording systems, security campaigns, gallery highlights and videos from the YASH TECH Instagram profile.</p><nav class="gallery-jump-nav" aria-label="Gallery sections"><a href="#product-photos">Product photos</a><a href="#camera-collection">Camera collection</a><a href="#gallery-highlights">Gallery highlights</a><a href="#campaign-visuals">Campaigns</a><a href="#homepage-campaigns">Homepage campaigns</a><a href="#instagram-reels">Instagram Reels</a></nav></div></section>

  <section class="section command-gallery-section" id="product-photos"><div class="container"><div class="section-head"><div><div class="eyebrow">01 / PRODUCT PHOTOGRAPHY</div><h2>Cameras and recording systems.</h2></div><p>Browse product images from the YASH TECH catalogue. Open any image to view it at full size.</p></div><div class="archive-image-grid archive-products-grid">{currentProductPhotos.map(item => <a class="archive-image-card reveal" href={asset(item.image)} target="_blank" rel="noopener noreferrer" data-archive-card><div class="archive-image-stage"><img src={asset(item.image)} alt={item.alt} loading="lazy" width="520" height="420" /></div><div class="archive-image-copy"><span>PRODUCT / {String(item.number).padStart(2,'0')}</span><strong>{item.title}</strong><small>Open image ↗</small></div></a>)}</div></div></section>

  <section class="section command-gallery-section alt-gallery-section" id="camera-collection"><div class="container"><div class="section-head"><div><div class="eyebrow">02 / CAMERA COLLECTION</div><h2>More camera views.</h2></div><p>Explore additional camera, DVR and NVR images for a closer look at the range.</p></div><div class="archive-image-grid">{additionalProductPhotos.map(item => <a class="archive-image-card reveal" href={asset(item.image)} target="_blank" rel="noopener noreferrer" data-archive-card><div class="archive-image-stage"><img src={asset(item.image)} alt={item.title} loading="lazy" /></div><div class="archive-image-copy"><span>CAMERA / {String(item.number).padStart(2,'0')}</span><strong>{item.title}</strong><small>Open image ↗</small></div></a>)}</div></div></section>

  <section class="section command-gallery-section" id="gallery-highlights"><div class="container"><div class="section-head"><div><div class="eyebrow">03 / GALLERY HIGHLIGHTS</div><h2>Selected gallery highlights.</h2></div><p>Explore selected business, installation and brand imagery shared by YASH TECH.</p></div><div class="archive-logo-grid">{galleryImages.map(item => <a class="archive-logo-card reveal" href={asset(item.image)} target="_blank" rel="noopener noreferrer"><img src={asset(item.image)} alt={item.title} loading="lazy" /><span>{item.title}</span><small>View image {String(item.number).padStart(2,'0')}</small></a>)}<a class="archive-logo-card reveal" href={asset('assets/legacy-site/images/logo.png')} target="_blank" rel="noopener noreferrer"><img src={asset('assets/legacy-site/images/logo.png')} alt="YASH TECH logo" loading="lazy" /><span>YASH TECH</span><small>Brand image</small></a></div></div></section>

  <section class="section command-gallery-section alt-gallery-section" id="campaign-visuals"><div class="container"><div class="section-head"><div><div class="eyebrow">04 / CAMPAIGN VISUALS</div><h2>Security promotions and product visuals.</h2></div><p>Explore the camera and security-system campaign images used across YASH TECH communications.</p></div><div class="archive-banner-grid">{campaignImages.map(item => <a class="archive-banner-card reveal" href={asset(item.image)} target="_blank" rel="noopener noreferrer"><img src={asset(item.image)} alt={item.title} loading="lazy" /><span>{item.title} · Open full size ↗</span></a>)}</div><div class="archive-extra-grid">{additionalMedia.map(item => <a class="archive-extra-card reveal" href={asset(item.image)} target="_blank" rel="noopener noreferrer"><img src={asset(item.image)} alt={item.title} loading="lazy" /><span>{item.title} ↗</span></a>)}</div></div></section>

  <section class="section command-gallery-section" id="homepage-campaigns"><div class="container"><div class="section-head"><div><div class="eyebrow">05 / FEATURED BANNERS</div><h2>Homepage campaign collection.</h2></div><p>The seven featured banners are used in the homepage carousel. Open any banner to view the full original image.</p></div><div class="archive-banner-grid hero-archive-grid">{slides.map((item, index) => <a class="archive-banner-card reveal" href={asset(item.image)} target="_blank" rel="noopener noreferrer"><img src={asset(item.image)} alt={item.alt} loading="lazy" /><span>{String(index + 1).padStart(2,'0')} / {item.title} ↗</span></a>)}</div></div></section>

  <section class="section command-gallery-section alt-gallery-section" id="instagram-reels"><div class="container"><div class="section-head"><div><div class="eyebrow">06 / INSTAGRAM VIDEO</div><h2>Watch YASH TECH Reels.</h2></div><p>Play the original Instagram videos here where embedding is available, or open any Reel directly on Instagram.</p></div><InstagramReelGrid reels={reels} /><div class="instagram-follow-panel command-instagram-follow"><div><div class="eyebrow">OFFICIAL INSTAGRAM</div><h2>Follow @yashtechcctv.</h2><p>Product posts, videos and updates from YASH TECH.</p></div><a class="btn btn-primary" href="https://www.instagram.com/yashtechcctv/" target="_blank" rel="noopener noreferrer">Open Instagram profile ↗</a></div></div></section>
</Layout>
