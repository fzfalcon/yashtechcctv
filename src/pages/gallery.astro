---
import Layout from '../components/Layout.astro';
import InstagramReelGrid from '../components/InstagramReelGrid.astro';
import { BASE } from '../lib';
const reels = [{"id": "DecbWZYz1bk", "number": "01", "image": "assets/catalog/product-01.jpg"}, {"id": "DeCTb3UpncP", "number": "02", "image": "assets/catalog/product-02.jpg"}, {"id": "DeAPCdczwML", "number": "03", "image": "assets/catalog/product-03.jpg"}, {"id": "DdMsfgjTcNp", "number": "04", "image": "assets/catalog/product-04.jpg"}, {"id": "Dc3qrbtJdqC", "number": "05", "image": "assets/catalog/product-05.jpg"}, {"id": "Dcq5zDDJ18u", "number": "06", "image": "assets/catalog/product-06.jpg"}, {"id": "DcqyQ9jpLcy", "number": "07", "image": "assets/catalog/product-07.jpg"}, {"id": "DcquMAdprVQ", "number": "08", "image": "assets/catalog/product-08.jpg"}, {"id": "DcjU_3ZJqXj", "number": "09", "image": "assets/catalog/product-09.jpg"}, {"id": "DcJs70vS6Xe", "number": "10", "image": "assets/catalog/product-10.jpg"}];
---
<Layout title="YASH TECH Gallery | Instagram Reels" description="Browse YASH TECH Instagram Reels, load public posts inline, or open the original Reel on Instagram.">
  <section class="page-hero">
    <div class="container">
      <div class="breadcrumbs"><a href={BASE}>Home</a> / Gallery & updates</div>
      <div class="eyebrow">Gallery & updates</div>
      <h1>See more from YASH TECH.</h1>
      <p>The actual Instagram Reels are embedded in the cards below. Use the video controls inside each Reel, or open it directly on Instagram if the embed is unavailable.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <InstagramReelGrid reels={reels} />
      <div class="instagram-follow-panel">
        <div><div class="eyebrow">Follow our updates</div><h2>More from YASH TECH.</h2><p>Product videos, security tips and updates from our official Instagram account.</p></div>
        <a class="btn btn-primary" href="https://www.instagram.com/yashtechcctv/" target="_blank" rel="noopener noreferrer">Follow @yashtechcctv ↗</a>
      </div>
    </div>
  </section>
</Layout>
