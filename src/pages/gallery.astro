---
import Layout from '../components/Layout.astro';
import { BASE, waLink } from '../lib';
---
<Layout title="YASH TECH Gallery | Instagram Reels" description="Explore the official Instagram profile and supplied Reels. Playback and previews are controlled by Instagram.">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={BASE}>Home</a> / Gallery & updates</div><div class="eyebrow">Gallery & updates</div><h1>See more from YASH TECH.</h1><p>Explore the official Instagram profile and supplied Reels. Playback and previews are controlled by Instagram.</p></div></section>
  <section class="section"><div class="container"><div class="reel-grid"><a class="reel-card reveal" href="https://www.instagram.com/reel/DecbWZYz1bk/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 01<br><small>Watch on Instagram ↗</small></span></a><a class="reel-card reveal" href="https://www.instagram.com/reel/DeCTb3UpncP/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 02<br><small>Watch on Instagram ↗</small></span></a><a class="reel-card reveal" href="https://www.instagram.com/reel/DeAPCdczwML/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 03<br><small>Watch on Instagram ↗</small></span></a><a class="reel-card reveal" href="https://www.instagram.com/reel/DdMsfgjTcNp/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 04<br><small>Watch on Instagram ↗</small></span></a><a class="reel-card reveal" href="https://www.instagram.com/reel/Dc3qrbtJdqC/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 05<br><small>Watch on Instagram ↗</small></span></a><a class="reel-card reveal" href="https://www.instagram.com/reel/Dcq5zDDJ18u/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 06<br><small>Watch on Instagram ↗</small></span></a><a class="reel-card reveal" href="https://www.instagram.com/reel/DcqyQ9jpLcy/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 07<br><small>Watch on Instagram ↗</small></span></a><a class="reel-card reveal" href="https://www.instagram.com/reel/DcquMAdprVQ/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 08<br><small>Watch on Instagram ↗</small></span></a><a class="reel-card reveal" href="https://www.instagram.com/reel/DcjU_3ZJqXj/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 09<br><small>Watch on Instagram ↗</small></span></a><a class="reel-card reveal" href="https://www.instagram.com/reel/DcJs70vS6Xe/" target="_blank" rel="noopener noreferrer"><span>YASH TECH Reel 10<br><small>Watch on Instagram ↗</small></span></a></div><p class="muted" style="margin-top:20px">Follow <a class="text-link" href="https://www.instagram.com/yashtechcctv/" target="_blank" rel="noopener noreferrer">@yashtechcctv</a> for updates.</p></div></section>
  <script>
    document.querySelectorAll<HTMLAnchorElement>('[data-enquiry]').forEach(link => {
      link.href = `https://wa.me/918667015532?text=${encodeURIComponent('Hello YASH TECH, I would like to enquire about ' + link.closest('article')?.querySelector('h3')?.textContent + '.') }`;
      link.target = '_blank'; link.rel = 'noopener noreferrer';
    });
    const form = document.querySelector<HTMLFormElement>('#enquiry-form');
    form?.addEventListener('submit', event => {
      event.preventDefault();
      const data = new FormData(form);
      const message = [
        'Hello YASH TECH, I would like to make an enquiry.',
        `Name: ${data.get('name') || 'Not provided'}`,
        `Phone: ${data.get('phone') || 'Not provided'}`,
        `Requirement: ${data.get('need') || 'Not specified'}`,
        `Details: ${data.get('details') || 'Not provided'}`
      ].join('\\n');
      window.open(`https://wa.me/918667015532?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });
  </script>
</Layout>
