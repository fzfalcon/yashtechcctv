---
import Layout from '../components/Layout.astro';
import { BASE, waLink } from '../lib';
---
<Layout title="About YASH TECH | CCTV & Security Solutions" description="YASH TECH is based in Ramanathapuram, Tamil Nadu, with a catalogue spanning CCTV cameras, recording systems, networking and access-control equipment.">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={BASE}>Home</a> / About YASH TECH</div><div class="eyebrow">About YASH TECH</div><h1>Practical security products and support.</h1><p>YASH TECH is based in Ramanathapuram, Tamil Nadu, with a catalogue spanning CCTV cameras, recording systems, networking and access-control equipment.</p></div></section>
  <section class="section"><div class="container"><div class="grid-3"><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Local presence</h3><p>152/1 Railway Station Road, opposite Kalyan Jewellerys, Ramanathapuram – 623504.</p><a class="text-link" href="#" data-enquiry>Get directions ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Product range</h3><p>Camera systems, DVR/NVR, CCTV accessories, networking, biometric attendance and access control.</p><a class="text-link" href="#" data-enquiry>Browse products ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Talk to the team</h3><p>Ask about current models, compatibility, pricing and installation requirements.</p><a class="text-link" href="#" data-enquiry>Contact YASH TECH ↗</a></article></div></div></section>
  <script>
    document.querySelectorAll<HTMLAnchorElement>('[data-enquiry]').forEach(link => {
      link.href = `https://wa.me/918667015532?text=${encodeURIComponent('Hello YASH TECH, I would like to enquire about ' + link.closest('article')?.querySelector('h3')?.textContent + '.') }`;
      link.target = '_blank'; link.rel = 'noopener noreferrer';
    });
    const form = document.querySelector<HTMLFormElement>('#enquiry-form');
    form?.addEventListener('submit', event => {
      event.preventDefault();
      const data = new FormData(form);
      const message = [
        'Hello YASH TECH, I would like to make an enquiry.',
        `Name: ${data.get('name') || 'Not provided'}`,
        `Phone: ${data.get('phone') || 'Not provided'}`,
        `Requirement: ${data.get('need') || 'Not specified'}`,
        `Details: ${data.get('details') || 'Not provided'}`
      ].join('\\n');
      window.open(`https://wa.me/918667015532?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });
  </script>
</Layout>
