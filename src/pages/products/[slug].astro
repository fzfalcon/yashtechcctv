---
import Layout from '../../components/Layout.astro';
import products from '../../data/products.json';
import { BASE, asset, waLink } from '../../lib';

export function getStaticPaths() {
  return products.map(product => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const message = `Hello YASH TECH, I am interested in ${product.title}. Please confirm current availability, exact model and price.`;
---
<Layout title={`${product.title} | YASH TECH`} description={`${product.title} product details and enquiry from YASH TECH CCTV, Ramanathapuram.`}>
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={BASE}>Home</a> / <a href={`${BASE}products/`}>Products</a> / {product.title}</div><div class="eyebrow">{product.category}</div><h1>{product.title}</h1><p>{product.description}</p></div></section>
  <section class="section"><div class="container spec-layout"><div><div class="spec-image"><img src={asset(product.image)} alt={product.alt || product.title} width="700" height="600" fetchpriority="high" /></div><p class="muted" style="font-size:.82rem;margin-top:12px">Product appearance may vary by model variant. Contact YASH TECH if you need help confirming a particular model.</p><a class="btn btn-primary" style="margin-top:12px" href={waLink(message)} target="_blank" rel="noopener noreferrer">Ask about this product ↗</a></div><div><div class="eyebrow">Product information</div><h2 style="font-size:2rem;letter-spacing:-.04em">Specifications</h2>{product.specs.length ? <table class="spec-table"><tbody>{product.specs.map(row => <tr><th scope="row">{row.label}</th><td>{row.value}</td></tr>)}</tbody></table> : <p class="muted">Please contact YASH TECH to confirm exact specifications for this model.</p>}<div class="notice" style="margin-top:24px">Product features and compatibility can vary by model. Contact YASH TECH to confirm the exact specification, current price and availability.</div><a class="btn btn-secondary" href={`${BASE}products/`} style="margin-top:12px">← Back to catalogue</a></div></div></section>
</Layout>
