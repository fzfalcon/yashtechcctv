---
import Layout from '../components/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ProductCard from '../components/ProductCard.astro';
import InstagramReelGrid from '../components/InstagramReelGrid.astro';
import products from '../data/products.json';
import { BASE, asset, waLink } from '../lib';
const homeReels = [
  { id: 'DecbWZYz1bk', number: '01' },
  { id: 'DeCTb3UpncP', number: '02' },
  { id: 'DeAPCdczwML', number: '03' }
];
const featured = products.slice(0, 8);
const productFamilies = [
  { title: 'CCTV & IP cameras', detail: 'Indoor, outdoor and network camera options', image: 'assets/catalog/product-15.jpg', href: `${BASE}products/?q=IP%20camera`, icon: '◉' },
  { title: '4G & solar cameras', detail: 'Remote monitoring and solar-powered options', image: 'assets/catalog/product-04.jpg', href: `${BASE}products/?category=4G%20%2F%20Solar`, icon: '⌁' },
  { title: 'Wi-Fi cameras', detail: 'Connected cameras for home and business', image: 'assets/catalog/product-05.jpg', href: `${BASE}products/?category=Wi-Fi%20Cameras`, icon: '⌁' },
  { title: 'DVR & NVR systems', detail: 'Recording, storage and playback', image: 'assets/catalog/product-22.jpeg', href: `${BASE}products/?category=DVR%20%2F%20NVR`, icon: '▤' },
  { title: 'Power & accessories', detail: 'Components for complete systems', image: 'assets/catalog/product-21.jpg', href: `${BASE}products/?q=power%20accessories`, icon: '⎓' },
  { title: 'Biometric & access', detail: 'Entry and attendance systems', image: 'assets/legacy-site/images/tour/005.jpg', href: `${BASE}services/`, icon: '▣' }
];
const campaignBanners = [
  { image: 'assets/generated/02-solar-4g.webp', title: '4G & solar camera systems', detail: 'Explore monitoring options for locations where wired internet or power may be limited.', href: `${BASE}products/?category=4G%20%2F%20Solar`, alt: 'YASH TECH 4G and solar camera campaign' },
  { image: 'assets/generated/03-cctv-ip-cameras.webp', title: 'CCTV & IP cameras', detail: 'Find indoor, outdoor and network camera options for your property.', href: `${BASE}products/?q=IP%20camera`, alt: 'YASH TECH CCTV camera campaign' },
  { image: 'assets/generated/04-dvr-nvr-recording.webp', title: 'DVR & NVR recording', detail: 'Explore recording, storage and playback options for your security setup.', href: `${BASE}products/?category=DVR%20%2F%20NVR`, alt: 'YASH TECH DVR and NVR recording systems' },
  { image: 'assets/generated/05-access-control-intercom.webp', title: 'Integrated security systems', detail: 'Bring cameras, access control, networking and installation planning together.', href: `${BASE}services/`, alt: 'YASH TECH integrated security systems' }
];
const solutionBanners = [
  { image: 'assets/generated/06-networking-wifi.webp', title: 'Networking & connectivity', detail: 'Wi-Fi, Ethernet and structured cabling for connected security systems.', href: `${BASE}services/`, alt: 'Networking and Wi-Fi security systems' },
  { image: 'assets/generated/07-installation-solutions.webp', title: 'Professional installation', detail: 'Plan camera positions, cabling and recording around the needs of the site.', href: `${BASE}services/`, alt: 'Security camera installation solutions' },
  { image: 'assets/generated/08-home-business-protection.webp', title: 'Home & business protection', detail: 'Explore practical camera options for homes, shops and offices.', href: `${BASE}solutions/`, alt: 'Home and business security solutions' },
  { image: 'assets/generated/09-commercial-industrial.webp', title: 'Commercial & industrial sites', detail: 'Security planning for workspaces, warehouses, parking and outdoor areas.', href: `${BASE}solutions/`, alt: 'Commercial and industrial security systems' },
  { image: 'assets/generated/10-installation-gallery.webp', title: 'Real-world security setups', detail: 'Explore equipment and installation visuals from the YASH TECH media collection.', href: `${BASE}gallery/`, alt: 'YASH TECH security and installation visual collection' }
];
const featurePanels = [
  { label: 'CAMERA SYSTEMS', title: 'See more of what matters.', text: 'Explore camera options for entrances, rooms, storefronts and outdoor areas.', image: 'assets/hero/outdoor-bullet-camera.webp', href: `${BASE}products/` },
  { label: 'REMOTE LOCATIONS', title: 'Connect beyond cables.', text: 'Review 4G and solar-powered camera options for locations with different power and internet conditions.', image: 'assets/hero/solar-4g-outdoor.webp', href: `${BASE}products/?category=4G%20%2F%20Solar` },
  { label: 'RECORDING & STORAGE', title: 'Bring the system together.', text: 'Discuss recording capacity, compatible cameras, storage and playback requirements.', image: 'assets/hero/nvr-dvr-recording.webp', href: `${BASE}products/?category=DVR%20%2F%20NVR` }
];
const techCards = [
  { code: '01', tag: 'CAMERA SYSTEMS', title: 'Visual coverage', text: 'Choose camera types and placement around the views your site needs.', image: 'assets/hero/outdoor-bullet-camera.webp', link: 'Explore cameras', href: `${BASE}products/` },
  { code: '02', tag: 'RECORDING SYSTEMS', title: 'Recording & review', text: 'Compare DVR and NVR options around camera count, storage and compatibility.', image: 'assets/hero/nvr-dvr-recording.webp', link: 'Explore recording systems', href: `${BASE}products/?category=DVR%20%2F%20NVR` },
  { code: '03', tag: 'CONNECTIVITY', title: 'Connected monitoring', text: 'Explore Wi-Fi, IP and 4G camera options based on connectivity at the property.', image: 'assets/hero/smart-wifi-indoor.webp', link: 'Explore connected cameras', href: `${BASE}products/` },
  { code: '04', tag: 'INSTALLATION', title: 'Installation & integration', text: 'Plan cameras, cabling, networking and recording as one coordinated setup.', image: 'assets/hero/complete-cctv-solutions.webp', link: 'View services', href: `${BASE}services/` }
];
const galleryHighlights = [
  { name: 'Naga Healthcare Solution', image: 'assets/legacy-site/images/gallery/NAGA-HEALTHCARE-SOLUTION.jpg' },
  { name: 'Pon Suzuki', image: 'assets/legacy-site/images/gallery/PON-SUZUKI.jpg' },
  { name: 'Ramnad Enterprises', image: 'assets/legacy-site/images/gallery/RAMNAD-ENTERPRISES.jpeg' },
  { name: 'Skytech', image: 'assets/legacy-site/images/gallery/SKYTECH.jpeg' },
  { name: 'TMB', image: 'assets/legacy-site/images/gallery/TMB.jpeg' },
  { name: 'Union Bank of India', image: 'assets/legacy-site/images/gallery/UBI.jpeg' },
  { name: 'UTA', image: 'assets/legacy-site/images/gallery/UTA.jpeg' },
  { name: 'Yamaha', image: 'assets/legacy-site/images/gallery/YAMAHA.jpeg' }
];
const fieldPhotos = [
  { image: 'assets/legacy-site/images/yt/008.jpg', alt: 'YASH TECH security campaign image' },
  { image: 'assets/legacy-site/images/yt/016.jpg', alt: 'YASH TECH outdoor camera campaign' },
  { image: 'assets/legacy-site/images/yt/017.jpg', alt: 'YASH TECH security equipment campaign' },
  { image: 'assets/legacy-site/images/banner/WhatsApp_Image_2022-12-03_at_10_44_19_(1).jpeg', alt: 'YASH TECH CCTV systems and services banner' },
  { image: 'assets/generated/09-commercial-industrial.webp', alt: 'YASH TECH commercial and industrial security campaign' },
  { image: 'assets/generated/10-installation-gallery.webp', alt: 'YASH TECH installation and security systems campaign' }
];
const insightCards = [
  { number: '01', tag: 'CAMERA SELECTION', title: 'Start with the view you need.', text: 'Think about mounting height, lighting, viewing angle and the areas that need coverage before choosing a camera.', image: 'assets/catalog/product-15.jpg', href: `${BASE}products/` },
  { number: '02', tag: 'CONNECTIVITY', title: 'Choose how your camera connects.', text: 'Wi-Fi, Ethernet and 4G suit different sites. Availability depends on signal, network and installation conditions.', image: 'assets/hero/solar-4g-outdoor.webp', href: `${BASE}products/?category=4G%20%2F%20Solar` },
  { number: '03', tag: 'RECORDING', title: 'Plan for the footage you need.', text: 'Camera count, recording duration and storage compatibility all help determine the right recording setup.', image: 'assets/hero/nvr-dvr-recording.webp', href: `${BASE}products/?category=DVR%20%2F%20NVR` }
];
---
<Layout title="YASH TECH | CCTV Cameras, Security Systems & Installation" description="Explore CCTV cameras, 4G and solar cameras, Wi-Fi cameras, recording systems, networking and security installation support from YASH TECH in Ramanathapuram, Tamil Nadu.">
  <HeroCarousel />

  <section class="v30-product-selector section-tight" id="products">
    <div class="container">
      <div class="v30-section-heading">
        <div><span class="v30-eyebrow">PRODUCTS / FIND YOUR SYSTEM</span><h2>Find the right security setup.</h2></div>
        <p>Browse product families and move directly to the equipment that fits your property, connection and monitoring needs.</p>
      </div>
      <div class="v30-family-grid">
        {productFamilies.map((item, index) => (
          <a href={item.href} class="v30-family-card reveal">
            <div class="v30-family-card-top"><span>{String(index + 1).padStart(2, '0')} / SYSTEM</span><b aria-hidden="true">↗</b></div>
            <div class="v30-family-photo"><img src={asset(item.image)} alt={item.title} loading="lazy" /></div>
            <div class="v30-family-info"><h3>{item.title}</h3><p>{item.detail}</p><span>Explore category <b aria-hidden="true">→</b></span></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="v30-feature-products section">
    <div class="container">
      <div class="v30-section-heading">
        <div><span class="v30-eyebrow">PRODUCT SPOTLIGHTS</span><h2>Security equipment, up close.</h2></div>
        <p>Explore the catalogue, review available product information and contact YASH TECH to confirm exact specifications and pricing.</p>
      </div>
      <div class="v30-section-toolbar"><span><i></i> {products.length} PRODUCTS</span><a href={`${BASE}products/`} class="v30-inline-link">View all products <b aria-hidden="true">↗</b></a></div>
      <div class="grid-4 v30-featured-product-grid">{featured.map((product, index) => <ProductCard product={product} index={index} />)}</div>
      <div class="v30-center-action"><a class="btn btn-secondary" href={`${BASE}products/`}>Browse the complete catalogue <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="v31-campaign-section section" aria-labelledby="v31-campaign-heading">
    <div class="container">
      <div class="v30-section-heading">
        <div><span class="v30-eyebrow">EXPLORE / SECURITY CAMPAIGNS</span><h2 id="v31-campaign-heading">Explore the systems that protect your space.</h2></div>
        <p>Start with a camera system, recording setup or integrated security requirement. YASH TECH can help confirm suitable options and availability.</p>
      </div>
      <div class="v31-campaign-grid">
        {campaignBanners.map((item, index) => (
          <a class="v31-campaign-card reveal" href={item.href}>
            <div class="v31-campaign-image"><img src={asset(item.image)} alt={item.alt} loading="lazy" /></div>
            <div class="v31-campaign-copy"><span>{String(index + 1).padStart(2, '0')} / YASH TECH SOLUTIONS</span><h3>{item.title}</h3><p>{item.detail}</p><b>Explore solution <span aria-hidden="true">↗</span></b></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="v30-solution-spotlight section">
    <div class="container">
      <div class="v30-section-heading">
        <div><span class="v30-eyebrow">SOLUTIONS / BY SPACE</span><h2>Security for real places.</h2></div>
        <p>Choose a starting point for your site. Camera placement, recording and connectivity can then be planned around the space.</p>
      </div>
      <div class="v30-feature-panel-grid">
        {featurePanels.map((panel, index) => (
          <a class:list={['v30-feature-panel', `v30-feature-panel-${index + 1}`, 'reveal']} href={panel.href}>
            <img src={asset(panel.image)} alt="" loading="lazy" />
            <div class="v30-feature-panel-overlay"></div>
            <div class="v30-feature-panel-copy"><span>{panel.label}</span><h3>{panel.title}</h3><p>{panel.text}</p><b>Explore <span aria-hidden="true">↗</span></b></div>
          </a>
        ))}
      </div>
      <div class="v30-scenario-row"><a href={`${BASE}solutions/`}>Home & villa <span>↗</span></a><a href={`${BASE}solutions/`}>Retail & shops <span>↗</span></a><a href={`${BASE}solutions/`}>Office & warehouse <span>↗</span></a><a href={`${BASE}solutions/`}>Outdoor & remote sites <span>↗</span></a></div>
    </div>
  </section>

  <section class="v30-core-tech section">
    <div class="container">
      <div class="v30-section-heading">
        <div><span class="v30-eyebrow">CORE SYSTEMS</span><h2>Every part has a purpose.</h2></div>
        <p>A well-planned security setup combines coverage, recording, connectivity and installation in a way that suits the site.</p>
      </div>
      <div class="v30-tech-grid">
        {techCards.map(item => (
          <article class="v30-tech-card reveal">
            <a class="v30-tech-image" href={item.href}><img src={asset(item.image)} alt={item.title} loading="lazy" /></a>
            <div class="v30-tech-copy"><span>{item.code} / {item.tag || 'SYSTEM TECHNOLOGY'}</span><h3>{item.title}</h3><p>{item.text}</p><a href={item.href} class="v30-inline-link">{item.link} <b aria-hidden="true">↗</b></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v31-solutions-showcase section" aria-labelledby="v31-solutions-heading">
    <div class="container">
      <div class="v30-section-heading">
        <div><span class="v30-eyebrow">SOLUTIONS / BY ENVIRONMENT</span><h2 id="v31-solutions-heading">Security for the way you work and live.</h2></div>
        <p>From connected homes to commercial sites, explore the visual guide and speak with YASH TECH to plan a suitable setup.</p>
      </div>
      <div class="v31-solutions-track">
        {solutionBanners.map((item, index) => (
          <a class="v31-solution-banner reveal" href={item.href}>
            <img src={asset(item.image)} alt={item.alt} loading="lazy" />
            <div class="v31-solution-banner-copy"><span>{String(index + 1).padStart(2, '0')} / SOLUTION</span><h3>{item.title}</h3><p>{item.detail}</p><b>Learn more ↗</b></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="v30-real-world section">
    <div class="container">
      <div class="v30-section-heading">
        <div><span class="v30-eyebrow">GALLERY / VISUAL HIGHLIGHTS</span><h2>See the YASH TECH range.</h2></div>
        <p>Explore product campaigns, gallery highlights and images associated with the YASH TECH collection.</p>
      </div>
      <div class="v30-gallery-highlight-grid">
        {fieldPhotos.map((item, index) => <a href={asset(item.image)} target="_blank" rel="noopener noreferrer" class:list={['v30-gallery-highlight', `v30-gallery-highlight-${index + 1}`, 'reveal']}><img src={asset(item.image)} alt={item.alt} loading="lazy" /><span>VIEW IMAGE <b aria-hidden="true">↗</b></span></a>)}
      </div>
      <div class="v30-gallery-logos" aria-label="Gallery highlights">
        {galleryHighlights.map(item => <a href={asset(item.image)} target="_blank" rel="noopener noreferrer" aria-label={`Open ${item.name} gallery image`}><img src={asset(item.image)} alt={item.name} loading="lazy" /></a>)}
      </div>
      <div class="v30-center-action"><a class="btn btn-secondary" href={`${BASE}gallery/`}>Explore the complete gallery <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section class="v30-video-section section">
    <div class="container">
      <div class="v30-section-heading">
        <div><span class="v30-eyebrow">YASH TECH / INSTAGRAM</span><h2>See YASH TECH in action.</h2></div>
        <p>Explore product videos and updates from the official YASH TECH Instagram profile.</p>
      </div>
      <InstagramReelGrid reels={homeReels} compact={true} />
      <div class="v30-media-actions"><a class="v30-inline-link" href="https://www.instagram.com/yashtechcctv/" target="_blank" rel="noopener noreferrer">Follow @yashtechcctv <b aria-hidden="true">↗</b></a><a class="v30-inline-link" href={`${BASE}gallery/#instagram-reels`}>View all ten Reels <b aria-hidden="true">↗</b></a></div>
    </div>
  </section>

  <section class="v30-insights section">
    <div class="container">
      <div class="v30-section-heading">
        <div><span class="v30-eyebrow">SECURITY KNOW-HOW</span><h2>Plan with the essentials in mind.</h2></div>
        <p>A few practical starting points can help you choose the right camera and recording setup for your property.</p>
      </div>
      <div class="v30-insight-grid">
        {insightCards.map(item => (
          <article class="v30-insight-card reveal">
            <a href={item.href} class="v30-insight-image"><img src={asset(item.image)} alt="" loading="lazy" /></a>
            <div class="v30-insight-copy"><span>{item.number} / {item.tag}</span><h3>{item.title}</h3><p>{item.text}</p><a class="v30-inline-link" href={item.href}>Explore options <b aria-hidden="true">↗</b></a></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="v30-company section">
    <div class="container v30-company-layout">
      <div class="v30-company-visual">
        <img class="v30-company-main" src={asset('assets/generated/11-company-expertise-crop.webp')} alt="YASH TECH security solutions showroom and expertise banner" loading="lazy" />
        <div class="v30-company-stamp"><img src={asset('assets/yash-tech-logo.png')} alt="YASH TECH" /><span>SECURITY SYSTEMS<br />RAMANATHAPURAM, TAMIL NADU</span></div>
        <img class="v30-company-small" src={asset('assets/generated/04-dvr-nvr-recording.webp')} alt="YASH TECH recording and monitoring systems" loading="lazy" />
      </div>
      <div class="v30-company-copy">
        <span class="v30-eyebrow">ABOUT YASH TECH</span>
        <h2>Security products.<br /><em>Practical support.</em></h2>
        <p>YASH TECH brings together CCTV cameras, recording systems, networking equipment and security installation support from Ramanathapuram, Tamil Nadu.</p>
        <div class="v30-company-values"><div><b>01</b><span><strong>Product guidance</strong><small>Discuss features and compatibility before choosing.</small></span></div><div><b>02</b><span><strong>System planning</strong><small>Consider the site, connectivity and recording needs.</small></span></div><div><b>03</b><span><strong>Installation support</strong><small>Talk through setup requirements with the team.</small></span></div></div>
        <a class="btn btn-secondary" href={`${BASE}about/`}>About YASH TECH <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="v30-where-to-buy section-tight">
    <div class="v30-where-backdrop"><img src={asset('assets/generated/12-customer-support-crop.webp')} alt="" loading="lazy" /></div>
    <div class="container v30-where-content">
      <div><span class="v30-eyebrow">VISIT / CONTACT YASH TECH</span><h2>Let's plan your security setup.</h2><p>Speak with YASH TECH about product options, installation requirements and availability.</p></div>
      <div class="v30-where-actions"><a class="btn btn-primary" href={waLink('Hello YASH TECH, I would like to discuss a CCTV/security setup.')} target="_blank" rel="noopener noreferrer">Enquire on WhatsApp <span aria-hidden="true">↗</span></a><a class="btn btn-secondary" href="https://www.google.com/maps/search/?api=1&query=152%2F1%20Railway%20Station%20Road%20Ramanathapuram%20623504" target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a></div>
      <div class="v30-where-address"><span>152/1 Railway Station Road, opposite Kalyan Jewellerys, Ramanathapuram – 623504</span><a href="tel:+919385898667">+91 93858 98667</a></div>
    </div>
  </section>
</Layout>
