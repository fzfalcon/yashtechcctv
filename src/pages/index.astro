---
import Layout from '../components/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ProductCard from '../components/ProductCard.astro';
import products from '../data/products.json';
import { BASE, waLink } from '../lib';
const featured = products.slice(0, 8);
---
<Layout title="YASH TECH CCTV | Modern Security Solutions" description="Explore CCTV cameras, solar and 4G cameras, recording systems, installation and security solutions from YASH TECH in Ramanathapuram.">
  <HeroCarousel />
  <section class="trust-strip"><div class="container trust-grid"><div class="trust-item"><strong>Camera systems</strong><span>Wi-Fi, 4G, IP and HD options</span></div><div class="trust-item"><strong>Recording solutions</strong><span>DVR and NVR options</span></div><div class="trust-item"><strong>Installation support</strong><span>Plan for your property</span></div><div class="trust-item"><strong>Local expertise</strong><span>Ramanathapuram, Tamil Nadu</span></div></div></section>
  <section class="section"><div class="container"><div class="section-head"><div><div class="eyebrow">Product catalogue</div><h2>Find the right view.</h2></div><p>Explore the catalogue, compare product information and ask YASH TECH to confirm availability and pricing.</p></div><div class="grid-4">{featured.map(product => <ProductCard product={product} />)}</div><div style="display:flex;justify-content:center;margin-top:34px"><a class="btn btn-secondary" href={`${BASE}products/`}>Browse all 23 products ↗</a></div></div></section>
  <section class="section instagram-section"><div class="container"><div class="section-head"><div><div class="eyebrow">Instagram updates</div><h2>See YASH TECH in action.</h2></div><p>Explore product highlights and updates from our official Instagram Reels.</p></div><div class="home-reel-grid">
    <a class="home-reel-card reveal" href="https://www.instagram.com/reel/DecbWZYz1bk/" target="_blank" rel="noopener noreferrer"><img src={`${BASE}assets/catalog/product-01.jpg`} alt="YASH TECH product preview — Instagram Reel 01" loading="lazy" /><span class="home-reel-play" aria-hidden="true">▶</span><strong>Watch Reel 01 ↗</strong></a>
    <a class="home-reel-card reveal" href="https://www.instagram.com/reel/DeCTb3UpncP/" target="_blank" rel="noopener noreferrer"><img src={`${BASE}assets/catalog/product-02.jpg`} alt="YASH TECH product preview — Instagram Reel 02" loading="lazy" /><span class="home-reel-play" aria-hidden="true">▶</span><strong>Watch Reel 02 ↗</strong></a>
    <a class="home-reel-card reveal" href="https://www.instagram.com/reel/DeAPCdczwML/" target="_blank" rel="noopener noreferrer"><img src={`${BASE}assets/catalog/product-03.jpg`} alt="YASH TECH product preview — Instagram Reel 03" loading="lazy" /><span class="home-reel-play" aria-hidden="true">▶</span><strong>Watch Reel 03 ↗</strong></a>
    <a class="home-reel-card reveal" href="https://www.instagram.com/reel/DdMsfgjTcNp/" target="_blank" rel="noopener noreferrer"><img src={`${BASE}assets/catalog/product-04.jpg`} alt="YASH TECH product preview — Instagram Reel 04" loading="lazy" /><span class="home-reel-play" aria-hidden="true">▶</span><strong>Watch Reel 04 ↗</strong></a>
    <a class="home-reel-card reveal" href="https://www.instagram.com/reel/Dc3qrbtJdqC/" target="_blank" rel="noopener noreferrer"><img src={`${BASE}assets/catalog/product-05.jpg`} alt="YASH TECH product preview — Instagram Reel 05" loading="lazy" /><span class="home-reel-play" aria-hidden="true">▶</span><strong>Watch Reel 05 ↗</strong></a>
  </div><div class="instagram-cta"><span>Follow <strong>@yashtechcctv</strong> for more product videos and updates.</span><a class="text-link" href="https://www.instagram.com/yashtechcctv/" target="_blank" rel="noopener noreferrer">Open Instagram ↗</a><a class="text-link" href={`${BASE}gallery/`}>View all Reels ↗</a></div></div></section>
  <section class="section-tight"><div class="container"><div class="section-head"><div><div class="eyebrow">How we help</div><h2>Security is more than a camera.</h2></div><p>Start with the site, coverage needs and equipment requirements. We can help you discuss a practical setup.</p></div><div class="grid-3"><article class="surface-card service-card reveal"><div class="service-icon">◉</div><h3>CCTV products</h3><p>Explore cameras, recorders, power supplies and accessories.</p><a class="text-link" href={`${BASE}products/`}>Explore products ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">⌁</div><h3>Installation planning</h3><p>Discuss camera placement, cabling, recording and connectivity.</p><a class="text-link" href={`${BASE}services/`}>View services ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">⌖</div><h3>Tailored solutions</h3><p>Share the property type and goals to discuss a suitable security setup.</p><a class="text-link" href={waLink('Hello YASH TECH, I would like help planning a CCTV system for my property.')}>Talk to YASH TECH ↗</a></article></div></div></section>
  <section class="section"><div class="container"><div class="surface-card" style="padding:clamp(26px,6vw,60px);display:flex;align-items:center;justify-content:space-between;gap:26px;flex-wrap:wrap;background:linear-gradient(110deg,#0d2734,#0a1420 62%,#192719)"><div><div class="eyebrow">Need help choosing?</div><h2 style="font-size:clamp(2rem,4vw,3.5rem);letter-spacing:-.055em;line-height:1.05;margin:14px 0">Let's plan your security setup.</h2><p class="muted" style="max-width:600px">Send your requirements to YASH TECH and ask about current product options and installation.</p></div><a class="btn btn-primary" href={waLink('Hello YASH TECH, I would like to discuss a CCTV/security setup.')} target="_blank" rel="noopener noreferrer">Enquire on WhatsApp ↗</a></div></div></section>
</Layout>
