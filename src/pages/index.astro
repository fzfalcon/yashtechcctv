---
import Layout from '../components/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import ProductCard from '../components/ProductCard.astro';
import InstagramReelGrid from '../components/InstagramReelGrid.astro';
import products from '../data/products.json';
import { BASE, asset, waLink } from '../lib';
const instagramReels = [
  { id: 'DecbWZYz1bk', number: '01' },
  { id: 'DeCTb3UpncP', number: '02' },
  { id: 'DeAPCdczwML', number: '03' }
];
const featured = products.slice(0, 8);
const categories = [
  { title: '4G / Solar', detail: 'Remote outdoor monitoring', image: 'assets/catalog/product-04.jpg', href: `${BASE}products/?category=4G%20%2F%20Solar`, code: 'CAT / 01' },
  { title: 'Wi-Fi Cameras', detail: 'Connected indoor & outdoor', image: 'assets/catalog/product-05.jpg', href: `${BASE}products/?category=Wi-Fi%20Cameras`, code: 'CAT / 02' },
  { title: 'Outdoor Bullet', detail: 'Fixed-view camera options', image: 'assets/catalog/product-15.jpg', href: `${BASE}products/`, code: 'CAT / 03' },
  { title: 'DVR / NVR', detail: 'Recording and storage', image: 'assets/legacy-site/images/tour/WhatsApp_Image_2022-12-10_at_10_36_27_AM.jpeg', href: `${BASE}products/`, code: 'CAT / 04' },
  { title: 'Indoor Cameras', detail: 'Compact smart monitoring', image: 'assets/catalog/product-13.jpg', href: `${BASE}products/`, code: 'CAT / 05' },
  { title: 'Accessories', detail: 'Build a complete system', image: 'assets/legacy-site/images/tour/005.jpg', href: `${BASE}products/`, code: 'CAT / 06' }
];
const clientLogos = [
  { name: 'SKYTECH', image: 'assets/legacy-site/images/gallery/SKYTECH.jpeg' },
  { name: 'Ramnad Enterprises', image: 'assets/legacy-site/images/gallery/RAMNAD-ENTERPRISES.jpeg' },
  { name: 'Naga Healthcare Solution', image: 'assets/legacy-site/images/gallery/NAGA-HEALTHCARE-SOLUTION.jpg' },
  { name: 'Pon Suzuki', image: 'assets/legacy-site/images/gallery/PON-SUZUKI.jpg' },
  { name: 'Yamaha', image: 'assets/legacy-site/images/gallery/YAMAHA.jpeg' },
  { name: 'TMB', image: 'assets/legacy-site/images/gallery/TMB.jpeg' },
  { name: 'Union Bank of India', image: 'assets/legacy-site/images/gallery/UBI.jpeg' },
  { name: 'UTA', image: 'assets/legacy-site/images/gallery/UTA.jpeg' }
];
const archivePhotos = [
  { name: 'Business security visual', image: 'assets/legacy-site/images/yt/008.jpg' },
  { name: 'Outdoor camera campaign', image: 'assets/legacy-site/images/yt/016.jpg' },
  { name: 'Security camera campaign', image: 'assets/legacy-site/images/yt/017.jpg' },
  { name: 'Original CCTV systems banner', image: 'assets/legacy-site/images/banner/WhatsApp_Image_2022-12-03_at_10_44_19_(1).jpeg' }
];
---
<Layout title="YASH TECH | Smart Security Systems & Solutions" description="Explore CCTV cameras, solar and 4G cameras, Wi-Fi cameras, recording systems and security installation support from YASH TECH, Ramanathapuram.">
  <HeroCarousel />
  <section class="command-trust-strip"><div class="container command-trust-grid"><div><span>01 / CONNECT</span><strong>4G · Wi-Fi · IP</strong><small>Camera systems for different sites</small></div><div><span>02 / RECORD</span><strong>DVR · NVR</strong><small>Recording system options</small></div><div><span>03 / INTEGRATE</span><strong>Networking · Access</strong><small>Connected security equipment</small></div><div><span>04 / SUPPORT</span><strong>YASH TECH</strong><small>Ramanathapuram, Tamil Nadu</small></div></div></section>

  <section class="section command-categories-section" id="command-categories"><div class="container"><div class="section-head"><div><div class="eyebrow">01 / SYSTEM MODULES</div><h2>Shop by security category.</h2></div><p>Start with the type of space or equipment you want to protect. Explore the catalogue and confirm model compatibility with YASH TECH.</p></div><div class="command-category-grid">{categories.map((item, index) => <a class="command-category-card reveal" href={item.href}><div class="command-category-meta"><span>{item.code}</span><span aria-hidden="true">↗</span></div><div class="command-category-image"><img src={asset(item.image)} alt={item.title} loading="lazy" /></div><div class="command-category-copy"><h3>{item.title}</h3><p>{item.detail}</p><span>View category <b>↗</b></span></div></a>)}</div></div></section>

  <section class="section command-products-section"><div class="container"><div class="section-head"><div><div class="eyebrow">02 / PRODUCT DATABASE</div><h2>Equipment, clearly presented.</h2></div><p>Explore archived catalogue listings with product photos, available specifications and direct enquiry links.</p></div><div class="command-featured-top"><span><i></i> {products.length} CATALOGUE LISTINGS</span><a class="text-link" href={`${BASE}products/`}>Open full catalogue ↗</a></div><div class="grid-4">{featured.map((product, index) => <ProductCard product={product} index={index} />)}</div><div class="command-centered-action"><a class="btn btn-secondary" href={`${BASE}products/`}>Browse all products ↗</a></div></div></section>

  <section class="section command-solutions-section"><div class="container"><div class="section-head"><div><div class="eyebrow">03 / SECURITY OPERATIONS</div><h2>Choose a setup for your space.</h2></div><p>Plan around the property, monitoring needs and available connectivity instead of buying on model names alone.</p></div><div class="command-solution-grid"><a class="command-solution-card solution-home" href={`${BASE}solutions/`}><img class="solution-art" src={asset("assets/hero/complete-cctv-solutions.webp")} alt="" loading="lazy" /><span class="solution-code">SITE / 01</span><div><h3>Home security</h3><p>Entry points, family spaces and remote viewing options.</p><span>Explore solution ↗</span></div></a><a class="command-solution-card solution-retail" href={`${BASE}solutions/`}><img class="solution-art" src={asset("assets/hero/cctv-combo-kit.webp")} alt="" loading="lazy" /><span class="solution-code">SITE / 02</span><div><h3>Retail & shops</h3><p>Customer areas, counters, stock rooms and entry coverage.</p><span>Explore solution ↗</span></div></a><a class="command-solution-card solution-office" href={`${BASE}solutions/`}><img class="solution-art" src={asset("assets/hero/nvr-dvr-recording.webp")} alt="" loading="lazy" /><span class="solution-code">SITE / 03</span><div><h3>Office & warehouse</h3><p>Site-specific camera placement, recording and connectivity.</p><span>Explore solution ↗</span></div></a></div></div></section>

  <section class="section ref-technology-section"><div class="container"><div class="section-head"><div><div class="eyebrow">04 / SECURITY TECHNOLOGY</div><h2>One system. Multiple layers of protection.</h2></div><p>Build a practical security setup by thinking through image coverage, recording and connectivity together. YASH TECH can help you review the options for your site.</p></div><div class="ref-technology-grid"><article class="ref-technology-card reveal"><div class="ref-technology-image"><img src={asset("assets/hero/outdoor-bullet-camera.webp")} alt="YASH TECH outdoor camera product campaign" loading="lazy" /></div><div class="ref-technology-copy"><span>01 / VISUAL COVERAGE</span><h3>See the important details.</h3><p>Explore indoor, outdoor and network camera options around the areas you need to monitor.</p><a class="text-link" href={`${BASE}products/`}>Explore cameras ↗</a></div></article><article class="ref-technology-card reveal"><div class="ref-technology-image"><img src={asset("assets/hero/nvr-dvr-recording.webp")} alt="YASH TECH recorder and monitoring campaign" loading="lazy" /></div><div class="ref-technology-copy"><span>02 / RECORD & REVIEW</span><h3>Keep footage organised.</h3><p>Discuss DVR/NVR choices, compatible cameras, channel counts and storage needs.</p><a class="text-link" href={`${BASE}products/`}>Explore recording systems ↗</a></div></article><article class="ref-technology-card reveal"><div class="ref-technology-image"><img src={asset("assets/hero/solar-4g-outdoor.webp")} alt="YASH TECH solar 4G outdoor camera campaign" loading="lazy" /></div><div class="ref-technology-copy"><span>03 / CONNECT REMOTE SITES</span><h3>Plan around the location.</h3><p>Review solar and 4G camera options where power or fixed internet may be limited.</p><a class="text-link" href={`${BASE}products/?category=4G%20%2F%20Solar`}>Explore 4G & solar ↗</a></div></article></div></div></section>

  <section class="section command-archive-section"><div class="container"><div class="section-head"><div><div class="eyebrow">05 / ORIGINAL MEDIA ARCHIVE</div><h2>Photos from the YASH TECH archive.</h2></div><p>Original product imagery, campaign photos and business-gallery assets from the previous website are retained in the redesigned gallery.</p></div><div class="command-archive-grid">{archivePhotos.map((item, index) => <a class:list={['command-archive-card', `archive-card-${index + 1}`]} href={asset(item.image)} target="_blank" rel="noopener noreferrer"><img src={asset(item.image)} alt={item.name} loading="lazy" /><span>{item.name} <b>↗</b></span></a>)}</div><div class="command-centered-action"><a class="btn btn-secondary" href={`${BASE}gallery/`}>Open complete image & Reel archive ↗</a></div></div></section>

  <section class="section command-logos-section"><div class="container"><div class="section-head"><div><div class="eyebrow">05 / ORIGINAL CLIENT GALLERY</div><h2>Names from the archived gallery.</h2></div><p>These image assets appeared in the previous YASH TECH website. Their appearance here preserves the original media archive.</p></div><div class="command-logo-strip">{clientLogos.map(item => <a href={asset(item.image)} target="_blank" rel="noopener noreferrer" aria-label={`View ${item.name} archived image`}><img src={asset(item.image)} alt={item.name} loading="lazy" /></a>)}</div></div></section>

  <section class="section instagram-home-section command-instagram-section"><div class="container"><div class="section-head"><div><div class="eyebrow">07 / SOCIAL VIDEO</div><h2>Real Reels. Real YASH TECH.</h2></div><p>Instagram embeds load the actual posts. If Instagram blocks an embed, open the original Reel directly.</p></div><InstagramReelGrid reels={instagramReels} compact={true} /><div class="instagram-home-cta"><span>Follow <strong>@yashtechcctv</strong> for product videos and updates.</span><a class="btn btn-secondary" href="https://www.instagram.com/yashtechcctv/" target="_blank" rel="noopener noreferrer">Open Instagram profile ↗</a><a class="text-link" href={`${BASE}gallery/`}>View all 10 Reels ↗</a></div></div></section>

  <section class="section-tight command-final-cta"><div class="container"><div class="command-cta-panel"><img class="command-cta-art" src={asset("assets/hero/smart-security-solutions.webp")} alt="" loading="lazy" /><div class="command-cta-copy"><div class="eyebrow">08 / ENQUIRY CHANNEL</div><h2>Let's plan your security setup.</h2><p>Tell us about your home, shop or business. Ask about current model options, installation and availability.</p></div><a class="btn btn-primary" href={waLink('Hello YASH TECH, I would like to discuss a CCTV/security setup.')} target="_blank" rel="noopener noreferrer">Enquire on WhatsApp ↗</a></div></div></section>
</Layout>
