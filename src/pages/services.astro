---
import Layout from '../components/Layout.astro';
import { BASE } from '../lib';
---
<Layout title="CCTV Installation & Security Services | YASH TECH" description="Discuss your site, coverage goals and equipment requirements with YASH TECH to plan a practical security setup.">
  <section class="page-hero"><div class="container"><div class="breadcrumbs"><a href={BASE}>Home</a> / Services</div><div class="eyebrow">Services</div><h1>From equipment selection to installation.</h1><p>Discuss your site, coverage goals and equipment requirements with YASH TECH to plan a practical security setup.</p></div></section>
  <section class="section"><div class="container"><div class="grid-3"><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>CCTV installation</h3><p>Camera placement, cabling, mounting and setup planning for homes and commercial spaces.</p><a class="text-link" href="#" data-enquiry>Discuss installation ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>System integration</h3><p>Discuss camera, recorder and network compatibility for a connected surveillance system.</p><a class="text-link" href="#" data-enquiry>Plan a system ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Networking &amp; connectivity</h3><p>Get help discussing network equipment and connectivity requirements for your security system.</p><a class="text-link" href="#" data-enquiry>Ask about networking ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Biometric &amp; access control</h3><p>Explore attendance and access-control options for your workplace.</p><a class="text-link" href="#" data-enquiry>Ask about access control ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Recording systems</h3><p>Discuss DVR and NVR options based on camera count and recording requirements.</p><a class="text-link" href="#" data-enquiry>Compare recorders ↗</a></article><article class="surface-card service-card reveal"><div class="service-icon">↗</div><h3>Maintenance &amp; support</h3><p>Contact YASH TECH to discuss troubleshooting, maintenance and service needs.</p><a class="text-link" href="#" data-enquiry>Request support ↗</a></article></div></div></section>
  <script>
    document.querySelectorAll<HTMLAnchorElement>('[data-enquiry]').forEach(link => {
      link.href = `https://wa.me/918667015532?text=${encodeURIComponent('Hello YASH TECH, I would like to enquire about ' + link.closest('article')?.querySelector('h3')?.textContent + '.') }`;
      link.target = '_blank'; link.rel = 'noopener noreferrer';
    });
    const form = document.querySelector<HTMLFormElement>('#enquiry-form');
    form?.addEventListener('submit', event => {
      event.preventDefault();
      const data = new FormData(form);
      const message = [
        'Hello YASH TECH, I would like to make an enquiry.',
        `Name: ${data.get('name') || 'Not provided'}`,
        `Phone: ${data.get('phone') || 'Not provided'}`,
        `Requirement: ${data.get('need') || 'Not specified'}`,
        `Details: ${data.get('details') || 'Not provided'}`
      ].join('\\n');
      window.open(`https://wa.me/918667015532?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });
  </script>
</Layout>
